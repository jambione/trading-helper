# signal_engine.env — configuration for signal_engine.py
# Copy this file next to signal_engine.py on whatever machine you run it on.
# signal_engine.py loads this file automatically at startup.
# Lines starting with # are comments and are ignored.

# ── Dashboard connection ───────────────────────────────────────────────────────
# Address of your running dashboard.  No trailing slash.
DASHBOARD_URL=https://trading.jbrasfield.com

# Login credentials — same username and password you use in the browser.
DASHBOARD_USER=
DASHBOARD_PASS=

# ── Finnhub API key ───────────────────────────────────────────────────────────
# Real-time trade prices via WebSocket — free tier, up to 50 symbols, market hours only.
# Found at https://finnhub.io → Dashboard → API Keys
# If left blank, prices will fall back to the dashboard's last-seen value.
FINNHUB_API_KEY=d764hl9r01qm4b7su3mgd764hl9r01qm4b7su3n0

# ── Alpaca API keys ────────────────────────────────────────────────────────────
# Used for historical bar data (RSI/MACD warmup).
# Found at https://alpaca.markets → your account → API Keys
ALPACA_API_KEY=PKMK66QC2HCLAWJ42YGZWGYWUM  # pragma: allowlist secret (paper key)
ALPACA_SECRET_KEY=DzWk51ewMtnwebbYxR3QkNZ8TfaxWt3PmKYERnozNTA7  # pragma: allowlist secret

# ── Massive.com API key ────────────────────────────────────────────────────────
# When set, tickers with 5+ mention alerts (is_hot) will fetch OHLCV bar data
# from Massive first, then fall back to Alpaca.
#
# Free tier (Stocks Basic): end-of-day bars only — useful for overnight warmup,
#   not intraday.  Signals still run on Alpaca intraday bars.
# Paid tier ($29/mo Starter): 15-minute delayed intraday bars — replaces Alpaca
#   bar fetching for alert tickers.
#
# Get your key at: https://massive.com/dashboard/keys
MASSIVE_API_KEY=your_key_here  # pragma: allowlist secret

# How often to write signal_state.json (seconds) — dashboard reads this for
# the proximity progress bar.  Default 5s.
# SIGNAL_STATE_INTERVAL=5

# ── Trader mode ───────────────────────────────────────────────────────────────
# Controls whether the signal engine places orders or just logs signals.
# Requires: pip install alpaca-py
#
#   off   — log signals only, no orders placed (default, safe)
#   paper — paper trade via Alpaca + log ($100k fake money, same API keys)
#   live  — real money via Alpaca + log  ⚠️  test on paper first!
TRADER_MODE=paper

# Dollar amount to spend per BUY signal (notional order — Alpaca handles
# fractional shares automatically).
# TRADE_AMOUNT=500

# Maximum price per share — skip the BUY if the stock is above this price.
# Set to 0 (or leave commented) to disable the limit.
MAX_PRICE=5

# Enable premarket / afterhours trading.
# When true, orders are sent as LIMIT orders at the current price with
# extended_hours=True — required by Alpaca for outside-market-hours trades.
# When false (default), standard DAY market orders are used.
# EXTENDED_HOURS=false

# ── Signal tuning (optional — defaults shown) ─────────────────────────────────
# How often to run the main loop (price checks + proximity log) — seconds
# POLL_INTERVAL=1

# How often to poll the dashboard for newly highlighted tickers — seconds
# (prices come from Finnhub WebSocket, not the dashboard poll)
# DASHBOARD_POLL_INTERVAL=5

# How often to pull fresh price bars from Alpaca per ticker (seconds)
# BAR_REFRESH=60

# Seconds between each new ticker's first bar fetch (prevents burst of Alpaca calls)
# BAR_STAGGER=5

# Drop a ticker after this many seconds if it NEVER showed a positive histogram
# (3 minutes — probably not moving)
# EXPIRY_COLD=180

# Drop a ticker after this many seconds if it showed positive hist but no BUY fired
# (10 minutes — came close, gave it extra time)
# EXPIRY_WARM=600

# Hard cap on number of tickers tracked at once
# MAX_ACTIVE_TICKERS=20

# Track every symbol on the dashboard ticker list (momentum desk), not only
# transcription "mentioned" / mention_burst. Enables RSI focus for Find It First
# and scanner names. Set 0 to require mentioned/burst/find_it_first only.
# TRACK_DESK_TICKERS=1

# Calendar days of bar history for steady-state refreshes
# BAR_LOOKBACK_DAYS=5

# Longer lookback until the first successful bar load (thin / after-hours IEX)
# BAR_LOOKBACK_THIN=20

# Seconds between retries after a failed first bar fetch
# BAR_FAIL_RETRY_S=20

# Number of 1-minute bars to fetch for indicator warmup
# BAR_COUNT=100

# RSI period
RSI_PERIOD=14

# MACD fast / slow / signal periods
# 12/26/9 is standard — faster response on 1-minute bars than the old 14/30/10
MACD_FAST=12
MACD_SLOW=26
MACD_SIG=9

# Don't buy if RSI is above this level (overbought filter)
RSI_BUY_MAX=65

# ── Priority mention system ───────────────────────────────────────────────────
# When a ticker gets this many new chat mentions within PRIORITY_WINDOW_SECONDS
# it is "hot" — a BUY fires on MACD momentum alone, RSI filter is ignored.
# The sell side always respects RSI + MACD signals regardless of how we bought.
# Set PRIORITY_MENTIONS=0 to disable the system.
# PRIORITY_MENTIONS=5
# PRIORITY_WINDOW_SECONDS=10

# Sell any open position when RSI rises above this level (overbought exit).
# Applies to all positions — priority or normal.  Set to 0 to disable.
# 75 is a reliable exit point for 1-minute momentum tops on low-float stocks.
RSI_SELL_OVERBOUGHT=75

# Risk management settings (%) — the small-consistent-profit scalp recipe:
# take the 2% when it's there, never let a loser run past 1%.
# (Per-second backstops; the 3-indicator sell signal can exit before either.)
STOP_LOSS=1.0
TAKE_PROFIT=2.0
# Attach broker-held bracket (TP+SL) on RTH market buys when both % above are >0.
# auto | on | off — auto = brackets when both STOP_LOSS and TAKE_PROFIT are set.
# Client-side exits in signal_engine still run as a backup.
BRACKET_EXITS=auto

# Live last-price source for the engine (free IEX poll — no SIP):
#   alpaca  — default; polls Alpaca latest trade (no Finnhub 50-symbol cap)
#   finnhub — Finnhub WebSocket only
#   both    — Alpaca first, Finnhub fallback
PRICE_SOURCE=alpaca

# Broker-held trailing stop after alert-mode buys (GTC). Client-side trail
# still runs as backup. Set off to disable.
BROKER_TRAIL=on

# ── Dynamic exit levels ───────────────────────────────────────────────────────
# DYNAMIC_EXIT=atr   stop = entry - (ATR_MULT_STOP × ATR)
#                    take = entry + (ATR_MULT_TAKE × ATR)
# DYNAMIC_EXIT=vwap  stop = VWAP at entry time (sell if price falls below VWAP)
#                    take = entry + (ATR_MULT_TAKE × ATR)  (uses ATR for upside)
# DYNAMIC_EXIT=off   use fixed STOP_LOSS / TAKE_PROFIT % above (default)
DYNAMIC_EXIT=off
# ATR_MULT_STOP=1.5
# ATR_MULT_TAKE=2.0

# ── Buy filters (off by default — enable after backtesting confirms improvement) ─
# BUY_FILTER_VWAP=false
# BUY_FILTER_OBV=false
# BUY_FILTER_CM_RSI=false
# BUY_FILTER_RVOL=false
# RVOL_MIN=3.0

# Force-sell after this many minutes regardless of MACD state.
# Momentum is the whole thesis — if it hasn't worked in 15 min, the trade is dead.
MAX_HOLD_MINUTES=15

# ── Profitability improvements ────────────────────────────────────────────────
# Consecutive growing histogram bars required before a BUY fires (1 = original)
HIST_CONFIRM_BARS=2
# Min hold time after buy before a MACD reversal sell can fire
MIN_HOLD_SECONDS=60
HOT_MIN_HOLD_SECONDS=30
# Max total dollar exposure across all open positions (0 = no cap)
# Caps simultaneous risk when multiple hot tickers fire at once.
# This is also the position-count cap: max positions = MAX_TOTAL_EXPOSURE / TRADE_AMOUNT
# (e.g. 1500 / 500 = at most 3 open positions).
MAX_TOTAL_EXPOSURE=1500

# ── 3-indicator strategy (STRATEGY_MODE=three_indicator) ─────────────────────
# The automated version of the discretionary TradingView workflow:
# CM RSI-2 (fast trigger) + %R Trend Exhaustion + MACD cross w/ wide separation.
STRATEGY_MODE=three_indicator
#
# Build live OHLCV bars from the Finnhub trade stream so the strategy sees a
# forming candle that updates per tick — closest match to TradingView charts.
REALTIME_BARS=1
#
# Min seconds in a position before a strategy reversal may close it.
# THREE_IND_MIN_HOLD=30
#
# Every parameter in strategy_three_indicator.DEFAULT_PARAMS can be overridden
# as THREE_IND_<PARAM> — sync these to your TradingView chart settings:
# THREE_IND_CM_RSI_LENGTH=2
# THREE_IND_CM_RSI_BUY_MAX=40
# THREE_IND_CM_RSI_SELL_MIN=90
# THREE_IND_RTE_THRESHOLD=20
# THREE_IND_RTE_SELL_FROM=-10
# THREE_IND_MACD_FAST=12
# THREE_IND_MACD_SLOW=26
# THREE_IND_MACD_SIGNAL=9
# THREE_IND_MACD_SEP_MULT=1.0
# THREE_IND_MACD_SEP_WINDOW=50
# THREE_IND_CONFIRM_WINDOW=8
# THREE_IND_TREND_LOOKBACK=2
#
# Exit mode — benchmarked 2026-06-12 (benchmarks/ab_bench_*.csv): "any" exits
# are hair-triggered (one of the 3 reversal conditions is ~always true in the
# backward window) and lost money on every dataset; "all" beat it everywhere.
THREE_IND_EXIT_MODE=all
#
# Catalyst gate — same benchmarks: indicator-only entries on the alert-pool
# microcaps were negative in all 17 configs. Require the mention burst.
THREE_IND_REQUIRE_HOT=1

# ── Pinned compare tickers (TV side-by-side validation) ──────────────────────
# Comma-separated symbols tracked from startup that never expire and get
# per-second forming-bar evaluation. Open these same charts on TradingView and
# verify the dashboard's CM / %R / MACD pills agree before trusting automation.
# COMPARE_TICKERS=AAPL,SPY

# ── Trade guard (account-level risk) ─────────────────────────────────────────
# Realized $ loss in one ET day that halts NEW buys for the rest of the day.
# Exits are never blocked. 0 = off.  Start conservative (e.g. 2-3 losing trades).
DAILY_LOSS_LIMIT=50
#
# Hard cap on closed round-trips per ET day (0 = off).
# MAX_TRADES_PER_DAY=0
#
# Pattern-day-trader protection: a margin account under $25k is flagged at
# 4 day trades in 5 business days.  warn = print and allow; block = refuse new
# buys once 3 are used; off = disabled.  Use block before going live <$25k.
PDT_PROTECT=warn
#
# Seconds between engine <-> Alpaca position reconciliations (adopts positions
# opened elsewhere, clears positions closed manually in the Alpaca UI).
# RECONCILE_INTERVAL_S=60

# ── Dashboard-managed settings (Engine panel) ──
COMPARE_TICKERS=AAPL,SPY
