<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jambi.ai-hold-check — weekday 10:35 ET session run (qualify 10:46, ask 11:00)
  SHADOW ONLY: logs AI HOLD/EXIT answers, places no orders, changes no desk setting (docs/studies/ai_hold_check_prereg.json).
  Runs in the GUI session so agy can read its Keychain login (never start it over ssh).
  Install (mini):
    cp config/com.jambi.ai-hold-check.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jambi.ai-hold-check.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jambi.ai-hold-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/jambimac/repo/trading-helper &amp;&amp; nice -n 10 .venv/bin/python tools/studies/ai_hold_check.py run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jambimac/repo/trading-helper</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>35</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/jambimac/repo/trading-helper/logs/ai_hold_check.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jambimac/repo/trading-helper/logs/ai_hold_check.log</string>
</dict>
</plist>
