<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jambi.ai-hold-check-smoke — pre-start smoke test; no schedule, run with launchctl kickstart
  SHADOW ONLY: logs AI HOLD/EXIT answers, places no orders, changes no desk setting (docs/studies/ai_hold_check_prereg.json).
  Runs in the GUI session so agy can read its Keychain login (never start it over ssh).
  Install (mini):
    cp config/com.jambi.ai-hold-check-smoke.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jambi.ai-hold-check-smoke.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jambi.ai-hold-check-smoke</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/jambimac/repo/trading-helper &amp;&amp; nice -n 10 .venv/bin/python tools/studies/ai_hold_check.py smoke</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jambimac/repo/trading-helper</string>
  <key>StandardOutPath</key>
  <string>/Users/jambimac/repo/trading-helper/logs/ai_hold_check.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jambimac/repo/trading-helper/logs/ai_hold_check.log</string>
</dict>
</plist>
