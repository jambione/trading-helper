# webull_agent.env — configuration for webull_agent.py
# ─────────────────────────────────────────────────────────────────────────────
# The agent is DISABLED by default.  It will run in dry-run mode (logging what
# it WOULD do) until you set ENABLED=true.
#
# FIRST-TIME SETUP:
#   1. Fill in your Webull credentials below.
#   2. Run:  python webull_agent.py --setup
#      This sends an MFA code to your email and saves session tokens.
#   3. Start the agent:  python webull_agent.py
#
# ENABLING LIVE ORDERS:
#   1. Test thoroughly with PAPER_TRADING=true first.
#   2. When satisfied, set PAPER_TRADING=false and ENABLED=true.
#   3. Restart the agent.

# ── Master switch ─────────────────────────────────────────────────────────────
# false (default) = dry-run only, no orders placed, logs what would happen
# true            = live order placement (paper or real depending on below)
ENABLED=false

# ── Account type ──────────────────────────────────────────────────────────────
# true  = Webull paper trading account (safe for testing)
# false = real money live account
PAPER_TRADING=true

# ── Webull credentials ────────────────────────────────────────────────────────
WEBULL_EMAIL=
WEBULL_PASS=
WEBULL_TRADING_PIN=
WEBULL_DEVICE_NAME=SignalEngine

# ── Trade sizing ──────────────────────────────────────────────────────────────
# Dollar amount to spend per BUY signal.
# Shares = floor(TRADE_AMOUNT / signal_price)
# e.g. $500 on a $50 stock = 10 shares
TRADE_AMOUNT=500

# ── Signal source ─────────────────────────────────────────────────────────────
# Path to signal_log.json written by signal_engine.py.
# Relative to webull_agent.py (or use an absolute path).
SIGNAL_LOG=signal_log.json

# ── Polling ───────────────────────────────────────────────────────────────────
# How often to check for new signals (seconds).
POLL_INTERVAL=1
