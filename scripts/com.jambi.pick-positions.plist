<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jambi.pick-positions - PAPER positions for the fact-sheet picker's picks (tools/pick_positions.py).
  Weekdays 09:32 local (ET): buys the picks whose entry day is today in the desk's Alpaca PAPER account, equal dollars,
  and sells each one 21 sessions later. Never the live account. Install / remove: scripts/install_pick_positions.sh [remove]
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jambi.pick-positions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jambimac/repo/trading-helper/.venv/bin/python</string>
    <string>-u</string>
    <string>/Users/jambimac/repo/trading-helper/tools/pick_positions.py</string>
    <string>sync</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jambimac/repo/trading-helper</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>32</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/jambimac/repo/trading-helper/logs/pick_positions.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jambimac/repo/trading-helper/logs/pick_positions.log</string>
</dict>
</plist>
