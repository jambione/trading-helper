#!/usr/bin/env bash
#
# trading — start/stop the LOCAL stack (dashboard + signal engine) in the
# background, with PID tracking, a health check, and a version readout.
#
#   ./trading start     launch dashboard + engine (background), wait until up
#   ./trading stop       graceful stop, then force-kill any stragglers
#   ./trading restart    stop then start (use after editing code — processes
#                        don't reload on their own)
#   ./trading status     what's running, for how long, and which build
#   ./trading logs       tail both logs (Ctrl+C to stop tailing)
#
# This is the local-dev control. For the full production session (Cloudflare
# tunnel, Discord, audio) use scripts/morning_start.sh / scripts/evening_stop.sh.

set -euo pipefail
cd "$(dirname "$0")"

ROOT="$(pwd)"
PORT=8888
URL="http://localhost:${PORT}"
LOGDIR="$ROOT/logs"
PIDFILE="$ROOT/.trading.pids"

if [ -x "venv/bin/python" ]; then
    PY="venv/bin/python"
else
    echo "⚠ venv not found — using system python3 (MLX Whisper may be unavailable)."
    PY="python3"
fi

# Cloudflare tunnel (exposes the local dashboard at the public hostname).
CF=""
for c in /opt/homebrew/bin/cloudflared /usr/local/bin/cloudflared; do
    [ -x "$c" ] && CF="$c" && break
done
CF_CONFIG="$ROOT/config/cloudflared-config.yml"
CF_TUNNEL="trading-helper"
PUBLIC_URL="https://trading.jbrasfield.com"

_running() { pgrep -f "$1" >/dev/null 2>&1; }
_tunnel_running() { pgrep -f "cloudflared.*$CF_TUNNEL" >/dev/null 2>&1; }

_start_tunnel() {
    if [ -z "$CF" ]; then
        echo "⚠ cloudflared not found — skipping tunnel."
        return 1
    fi
    if _tunnel_running; then
        echo "Tunnel already running → $PUBLIC_URL"
        return 0
    fi
    mkdir -p "$LOGDIR"
    echo "Starting Cloudflare tunnel → $PUBLIC_URL"
    nohup "$CF" tunnel --config "$CF_CONFIG" run "$CF_TUNNEL" >"$LOGDIR/tunnel.log" 2>&1 &
    echo "$!" >> "$PIDFILE"
    sleep 2
}

_stop_tunnel() {
    pkill -TERM -f "cloudflared.*$CF_TUNNEL" 2>/dev/null || true
    sleep 1
    pkill -KILL -f "cloudflared.*$CF_TUNNEL" 2>/dev/null || true
}

_version() {
    # Pull the build badge straight from the running dashboard.
    curl -s --max-time 3 "$URL/api/state" 2>/dev/null | "$PY" -c '
import sys, json
try:
    v = json.load(sys.stdin).get("version", {}) or {}
    print("   dashboard %s  |  engine %s  |  strategy %s" % (
        v.get("dashboard"), v.get("engine") or "off", v.get("engine_strategy") or "-"))
except Exception:
    print("   (dashboard not responding yet)")
' 2>/dev/null || echo "   (dashboard not responding yet)"
}

cmd_start() {
    # Tunnel starts by default; pass 'local' (or --no-tunnel) to stay local-only.
    local want_tunnel=1
    case "${1:-}" in local|--no-tunnel|notunnel|-n) want_tunnel=0 ;; esac

    if _running "dashboard.py" || _running "signal_engine.py"; then
        echo "Already running. Use './trading restart' to reload code, or './trading status'."
        [ "$want_tunnel" = 1 ] && _start_tunnel
        cmd_status
        return 0
    fi
    mkdir -p "$LOGDIR"
    : > "$PIDFILE"

    echo "Starting dashboard → $URL"
    nohup "$PY" -u dashboard.py      >"$LOGDIR/dashboard.log" 2>&1 &
    echo "$!" >> "$PIDFILE"

    # Wait for the dashboard to bind the port before launching the engine,
    # so the engine's first poll of localhost:8888 succeeds.
    for _ in $(seq 1 30); do
        curl -s --max-time 2 "$URL/api/meta" >/dev/null 2>&1 && break
        sleep 0.5
    done

    echo "Starting signal engine"
    nohup "$PY" -u signal_engine.py  >"$LOGDIR/engine.log" 2>&1 &
    echo "$!" >> "$PIDFILE"

    [ "$want_tunnel" = 1 ] && _start_tunnel

    sleep 2
    echo "✅ Started. Logs: $LOGDIR/{dashboard,engine}.log"
    _version
    echo "   Open $URL  (hard-refresh: Cmd+Shift+R)"
    _tunnel_running && echo "   Public: $PUBLIC_URL"
}

cmd_stop() {
    echo "Stopping…"
    # Graceful first — by tracked PID, then by name as a backstop.
    if [ -f "$PIDFILE" ]; then
        while read -r pid; do [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null || true; done < "$PIDFILE"
    fi
    pkill -TERM -f "signal_engine.py" 2>/dev/null || true
    pkill -TERM -f "dashboard.py"     2>/dev/null || true
    _stop_tunnel
    sleep 2
    # Force-kill anything still alive.
    pkill -KILL -f "signal_engine.py" 2>/dev/null || true
    pkill -KILL -f "dashboard.py"     2>/dev/null || true
    rm -f "$PIDFILE"
    echo "✅ Stopped (incl. tunnel)."
}

cmd_status() {
    local d e
    d=$(pgrep -f "dashboard.py"     | tr '\n' ' ' || true)
    e=$(pgrep -f "signal_engine.py" | tr '\n' ' ' || true)
    echo "dashboard : ${d:-not running}"
    echo "engine    : ${e:-not running}"
    if _tunnel_running; then
        echo "tunnel    : up → $PUBLIC_URL"
    else
        echo "tunnel    : not running"
    fi
    if [ -n "${d:-}" ]; then _version; fi
}

cmd_logs() {
    mkdir -p "$LOGDIR"
    local files="$LOGDIR/dashboard.log $LOGDIR/engine.log"
    [ -f "$LOGDIR/tunnel.log" ] && files="$files $LOGDIR/tunnel.log"
    tail -n 40 -f $files
}

case "${1:-}" in
    start)   shift; cmd_start "$@" ;;
    stop)    cmd_stop ;;
    restart) shift; cmd_stop; sleep 1; cmd_start "$@" ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    tunnel)
        case "${2:-}" in
            stop) _stop_tunnel; echo "✅ Tunnel stopped." ;;
            *)    _start_tunnel; _tunnel_running && echo "✅ Tunnel up → $PUBLIC_URL" ;;
        esac ;;
    *) cat <<'USAGE'
usage: ./trading <command>

  start [local]       start dashboard + engine + Cloudflare tunnel
                      (add 'local' to skip the tunnel and stay local-only)
  stop                stop dashboard + engine + tunnel
  restart [local]     stop then start (reload code after edits)
  status              what's running + which build
  logs                tail dashboard + engine (+ tunnel) logs
  tunnel [stop]       start/stop just the Cloudflare tunnel
USAGE
       exit 1 ;;
esac
